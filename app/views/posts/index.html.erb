<h1>スケジュール一覧</h1>

<div class="schedule-summary">
  <p>今日の日付：<%= Date.current.strftime("%Y/%m/%d") %></p>
  <p>スケジュール総数：<%= @posts.count %>件</p>
</div>

<div class="page-actions">
  <%= link_to "＋ 新規登録", new_post_path, class: "button button-primary" %>
</div>

<div class="table-wrapper">
  <table class="schedule-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>タイトル</th>
        <th>開始日</th>
        <th>終了日</th>
        <th>終日</th>
        <th>更新日時</th>
        <th>操作</th>
      </tr>
    </thead>

    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td><%= post.id %></td>
          <td class="title-cell"><%= post.title %></td>
          <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
          <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
          <td class="all-day-cell"><%= post.all_day ? "○" : "" %></td>
          <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
          <td class="action-cell">
            <%= link_to "詳細", post_path(post), class: "button button-small" %>
            <%= link_to "編集", edit_post_path(post), class: "button button-small" %>
            <%= link_to "削除", post_path(post),
                  class: "button button-small button-danger",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "本当に削除しますか？"
                  } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>